DB_CONNECTION_STRING=Host=localhost;Port=5433;Database=socialmedia;Username=postgres;Password=postgres

# HS256 needs a key of at least 32 characters
JWT_KEY=change-this-to-a-long-random-dev-only-key-of-32-plus-chars
JWT_ISSUER=SocialMediaPlatformAPI
JWT_AUDIENCE=SocialMediaPlatformApp
JWT_EXPIRE_MINUTES=120

ASPNETCORE_ENVIRONMENT=Development

REDIS_CONNECTION=localhost:6379,abortConnect=false
